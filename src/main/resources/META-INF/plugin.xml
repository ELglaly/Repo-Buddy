<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.elglaly.repobuddy</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>RepoBuddy</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor email="sherifelglaly@gmail.com" url="https://elglaly.github.io/Sherif-Elglaly/">Sherif Elglaly</vendor>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">

        <projectService
                serviceInterface="com.repoinspector.analysis.api.RepositoryAnalysisService"
                serviceImplementation="com.repoinspector.analysis.impl.DefaultRepositoryAnalysisService"/>
        <projectService
                serviceInterface="com.repoinspector.analysis.api.EndpointAnalysisService"
                serviceImplementation="com.repoinspector.analysis.impl.DefaultEndpointAnalysisService"/>
        <projectService
                serviceInterface="com.repoinspector.analysis.api.CallChainService"
                serviceImplementation="com.repoinspector.analysis.impl.DefaultCallChainService"/>
        <applicationService
                serviceInterface="com.repoinspector.runner.service.api.ParameterExtractionService"
                serviceImplementation="com.repoinspector.runner.service.impl.DefaultParameterExtractionService"/>

        <applicationService
                serviceInterface="com.repoinspector.analysis.api.OperationClassifierService"
                serviceImplementation="com.repoinspector.analysis.impl.DefaultOperationClassifierService"/>

        <codeInsight.lineMarkerProvider
                language="JAVA"
                implementationClass="com.repoinspector.gutter.RepoMethodGutterProvider"/>

        <localInspection
                language="JAVA"
                shortName="RepoBuddyUnsafeQuery"
                displayName="Unsafe @Query (injection surface / missing @Param)"
                groupName="RepoBuddy"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.repoinspector.inspections.UnsafeQueryInspection"/>

        <localInspection
                language="JAVA"
                shortName="RepoBuddyMissingPagination"
                displayName="Repository method missing pagination"
                groupName="RepoBuddy"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.repoinspector.inspections.MissingPaginationInspection"/>

        <localInspection
                language="JAVA"
                shortName="RepoBuddyMissingTransactional"
                displayName="Database write without @Transactional"
                groupName="RepoBuddy"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.repoinspector.inspections.MissingTransactionalInspection"/>


        <localInspection
                language="JAVA"
                shortName="RepoBuddyNPlusOneQuery"
                displayName="Potential N+1 query (lazy association or query call in loop)"
                groupName="RepoBuddy"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.repoinspector.inspections.NPlusOneQueryInspection"/>

        <localInspection
                language="JAVA"
                shortName="RepoBuddySelfInvocation"
                displayName="@Transactional self-invocation bypasses the proxy"
                groupName="RepoBuddy"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.repoinspector.inspections.SelfInvocationInspection"/>

        <toolWindow id="RepoBuddy"
                    anchor="bottom"
                    factoryClass="com.repoinspector.ui.RepoInspectorToolWindowFactory"/>

        <postStartupActivity
                implementation="com.repoinspector.runner.startup.AgentRunConfigPatcher"/>

        <notificationGroup id="RepoBuddy Notifications"
                           displayType="BALLOON"
                           toolWindowId="Event Log"/>

        <!-- Panel-only mode toggle (Settings | Tools | RepoBuddy) -->
        <applicationConfigurable parentId="tools"
                                 id="com.repoinspector.settings.RepoBuddyConfigurable"
                                 instance="com.repoinspector.settings.RepoBuddyConfigurable"
                                 displayName="RepoBuddy"/>

        <!-- Top-of-file banner counting RepoBuddy issues in the current file -->
        <editorNotificationProvider
                implementation="com.repoinspector.ui.RepoBuddyEditorBanner"/>

        <!-- Status-bar counter for RepoBuddy issues in the current file -->
        <statusBarWidgetFactory id="RepoBuddy.IssuesCount"
                                implementation="com.repoinspector.ui.RepoBuddyStatusBarWidgetFactory"/>

    </extensions>

    <projectListeners>
        <listener class="com.repoinspector.ui.RepoBuddyEditorSelectionListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>

    <applicationListeners>
        <listener class="com.repoinspector.runner.startup.AgentConfigCleaner"
                  topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    </applicationListeners>

    <actions>
        <action id="RepoBuddy.TraceRepositoryCalls"
                class="com.repoinspector.actions.TraceRepositoryCallsAction"
                text="Trace Repository Calls for This API"
                description="Trace all repository methods reachable from this Spring endpoint">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>

</idea-plugin>
